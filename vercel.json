{
    "rewrites": [
        {
            "source": "/api/tidb/(.*)",
            "destination": "https://http-gateway01.us-east-1.prod.aws.tidbcloud.com/$1"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}